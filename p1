using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace Practica01
{
    internal class Program
    {
        static public void lectura(int[] N)
        {
            for (int i = 0; i < N.Length; i++)
            {
                Console.Write("nota[" + i + "]=");
                N[i] = int.Parse(Console.ReadLine());
            }
        }
        static public void salida(int[] N)
        {
            for (int i = 0; i < N.Length; i++)
            {
                Console.WriteLine("Nota[" + i + "]=" + N[i]);
            }
        }
        static public void max(int[] N)
        {
            int mayor;
            mayor = N[0];
            for (int i = 0; i < N.Length; i++)
            {
                if (N[i] > mayor)
                    mayor = N[i];
            }
            Console.WriteLine("La maxima nota es: " + mayor);
        }
        static public void sum(int[] N)
        {
            int nota;
            int S = 0;
            for (int i = 0; i < N.Length; i++)
            {
                S +=N[i];
            }
            Console.WriteLine("la suma es: " + S);
        }

        static public void min(int[] N)
        {
            int menor;
            menor = N[0];
            for (int i = 0; i < N.Length; i++)
            {
                if (N[i] < menor)
                    menor = N[i];
            }
            Console.WriteLine("La minima nota es: " + menor);
        }
        static void Main(string[] args)
        {
            double Pro = 0;
            int N= 0;
            Console.WriteLine("Ingrese el numero de notas: ");
            N= int.Parse(Console.ReadLine());
            int[] notas = new int[N];
            lectura(notas);
            Pro = notas.Sum() / N;
            Console.WriteLine("El promedio es: " + Pro);
            max(notas);
            min(notas);
        }
    }
}
